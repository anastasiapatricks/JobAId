# LLM Provider Configuration
# Choose between "openai" (default) or "lmstudio"
LLM_PROVIDER=openai

# OpenAI — required for LLM agents
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: custom OpenAI endpoint

# Tavily — required for web search in market intelligence
TAVILY_API_KEY=tvly-...

# Adzuna — required for job board search
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Debug mode (optional, default false)
DEBUG=false

# LM Studio Configuration (only needed if LLM_PROVIDER=lmstudio)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1  # Default LM Studio endpoint
LMSTUDIO_BASE_URL=http://localhost:1234/v1
