# AWS region
region = "ap-southeast-1"

# EC2 instance type (t3.small = 2 vCPU, 2 GB RAM, ~$0.02/hr)
instance_type = "t3.small"

# Name of an existing EC2 key pair for SSH access
key_name = "your-key-pair-name"

# Your IP for SSH access (use /32 for a single IP)
allowed_ssh_cidr = "0.0.0.0/0"

# API keys (sensitive — do not commit this file)
openai_api_key = "sk-..."
tavily_api_key = "tvly-..."
adzuna_app_id  = ""
adzuna_api_key = ""
